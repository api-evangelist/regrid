  "info": {
    "_postman_id": "3765c50d-4f82-4d70-8c9f-684bc5fc4e6f",
    "name": "Regrid Parcel Metadata Typeahead API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "RESTful API for querying US and Canadian parcel records by location (lat/lon), street address, assessor parcel number (APN), owner name, or polygon area. Returns GeoJSON FeatureCollections with parcel boundaries, ownership, zoning, assessed values, and deed attributes. Supports up to 1,000 records per request with usage tracked by parcel records returned for billing purposes.\n\n\nContact Support:\n Name: Regrid Support",
      "type": "text/plain"
    }
  }
